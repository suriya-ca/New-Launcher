<?xml version="1.0" encoding="utf-8"?>
<com.sdev.newlauncher.ui.SwipeUpFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- ===================== HOME SCREEN ===================== -->
    <FrameLayout
        android:id="@+id/home_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.sdev.newlauncher.ui.Workspace
                    android:id="@+id/workspace"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="8dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/home_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="24dp"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="@string/home_hint"
                    android:textColor="#E6FFFFFF"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <!-- Page dots, only shown once a second home page exists. -->
            <LinearLayout
                android:id="@+id/home_page_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/dock_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_dock"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp">

                <!-- Takes all space left of the apps button so the dock icons stay centred. -->
                <FrameLayout
                    android:id="@+id/dock_apps_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/dock_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/apps_button"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/open_app_drawer"
                    android:padding="12dp"
                    android:src="@drawable/ic_apps" />
            </LinearLayout>

            <!-- Replaces the dock while the home screen is in edit mode. -->
            <LinearLayout
                android:id="@+id/home_edit_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edit_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:id="@+id/edit_wallpaper"
                    style="@style/HomeEditAction"
                    android:text="@string/home_edit_wallpaper" />

                <TextView
                    android:id="@+id/edit_widgets"
                    style="@style/HomeEditAction"
                    android:text="@string/home_edit_widgets" />

                <TextView
                    android:id="@+id/edit_settings"
                    style="@style/HomeEditAction"
                    android:text="@string/home_edit_settings" />

                <TextView
                    android:id="@+id/edit_add_page"
                    style="@style/HomeEditAction"
                    android:text="@string/home_edit_add_page" />

                <TextView
                    android:id="@+id/edit_done"
                    style="@style/HomeEditAction"
                    android:text="@string/home_edit_done" />
            </LinearLayout>
        </LinearLayout>

        <!-- Drop here to delete the item being dragged; only visible mid-drag. -->
        <LinearLayout
            android:id="@+id/home_remove_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_remove_target"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_delete" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/home_remove"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== APP DRAWER ===================== -->
    <FrameLayout
        android:id="@+id/drawer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_drawer"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search" />

                <com.sdev.newlauncher.ui.NoDragEditText
                    android:id="@+id/drawer_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_apps"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#99FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/drawer_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/drawer_pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <com.sdev.newlauncher.ui.AlphabetIndexBar
                    android:id="@+id/drawer_index_bar"
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/drawer_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/no_apps_found"
                    android:textColor="#B3FFFFFF"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/drawer_page_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== WIDGET SHEET ===================== -->
    <!-- In this window rather than a dialog, so widgets can be dragged out onto the home. -->
    <FrameLayout
        android:id="@+id/widget_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="gone">

        <View
            android:id="@+id/widget_sheet_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/widget_sheet_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_sheet_handle" />

            <TextView
                android:id="@+id/widgets_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widgets_title"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.sdev.newlauncher.ui.NoDragEditText
                android:id="@+id/widget_search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_search"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:hint="@string/widget_search_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#99FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widgets_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:text="@string/widgets_empty"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/widget_list"
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </FrameLayout>

</com.sdev.newlauncher.ui.SwipeUpFrameLayout>
