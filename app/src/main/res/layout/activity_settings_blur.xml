<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/settings_section_blur" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ===================== BLUR ===================== -->
            <LinearLayout style="@style/SettingsCard">

                <LinearLayout style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_blur" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitleInline"
                            android:text="@string/settings_blur_enabled" />

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_blur_enabled_summary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/blur_enabled_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitleInline"
                            android:text="@string/settings_blur_targets" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowTitleWeighted"
                        android:text="@string/settings_blur_target_drawer" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/blur_drawer_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowTitleWeighted"
                        android:text="@string/settings_blur_target_overview" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/blur_overview_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowTitleWeighted"
                        android:text="@string/settings_blur_target_sheets" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/blur_sheets_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== STRENGTH ===================== -->
            <LinearLayout
                android:id="@+id/blur_strength_card"
                style="@style/SettingsCard">

                <LinearLayout style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/SettingsRowTitleWeighted"
                                android:text="@string/settings_blur_radius" />

                            <TextView
                                android:id="@+id/blur_radius_value"
                                style="@style/SettingsRowValueInline"
                                tools:text="12 dp" />
                        </LinearLayout>

                        <TextView
                            style="@style/SettingsRowSummary"
                            android:text="@string/settings_blur_radius_summary" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/blur_radius_slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:stepSize="2"
                            android:value="12"
                            android:valueFrom="4"
                            android:valueTo="32" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
